    "fact-airc-5layer-arch": {
      "t": "fact",
      "v": "AIRC Semantic Engine 아키텍처: input → compile → index → runtime daemon → UI",
      "verified": true,
      "layers": {
        "1_input": [
          ".airc",
          ".fds",
          ".md",
          "git commits",
          "pm2 state",
          "logs",
          "graveyard"
        ],
        "2_compile": "canonical airc graph (project, task, decision, error, fact, assumption, user_intent, graveyard, dependency)",
        "3_index": "역인덱스 (blocked_by→projects, decision→services, error→workaround, service→freelang feature)",
        "4_runtime": "aircd daemon (graph cache, semantic search, dependency traversal, handoff context, provenance)",
        "5_ui": "web UI + CLI commands"
      },
      "lifecycle": {
        "state": "active"
      }
    },
    "fact-airc-4-queries": {
      "t": "fact",
      "v": "AIRC Semantic Engine 핵심 4가지 쿼리 타입",
      "verified": true,
      "queries": {
        "A_why": {
          "example": "airc why akl-crm",
          "output": [
            "blocked_by: [YIELD-2, ...]",
            "depends_on: [freelang-v11]",
            "last_decision: [dec-005]",
            "graveyard: [JS rewrite abandoned]"
          ]
        },
        "B_blocked_by_reverse": {
          "example": "airc blocked-by YIELD-2",
          "output": [
            "12 projects affected",
            "3 runtime failures",
            "2 abandoned rewrites"
          ]
        },
        "C_error_lineage": {
          "example": "airc trace err-003",
          "output": [
            "first_seen: 2026-05-20",
            "affected: [airc-parser.fl, pm2-dashboard]",
            "workaround: [shell-exec-result]",
            "status: unresolved"
          ]
        },
        "D_graveyard_why": {
          "example": "airc graveyard js-runtime",
          "output": [
            "abandoned because: [TS dependency remained, direction conflict with language independence]"
          ]
        }
      },
      "lifecycle": {
        "state": "active"
      }
    },
