    "u-008": {
      "t": "user_intent",
      "v": "AKL 서비스 UI 복구 + AIRC 기록 요청",
      "quote": "수정 하는거 계속하고 문서화를 airc 로 기록해",
      "source": "session-2026-05-20",
      "immutable": true
    },
    "err-008": {
      "t": "error",
      "v": "FreeLang ${} 보간 vs JS 템플릿 리터럴 충돌",
      "cause": "FL 문자열 내 ${expr} 구문을 FreeLang이 변수 보간으로 처리. \\${ 이스케이프도 무효 — $ 다음 { 를 여전히 보간으로 취급",
      "fix": "JS 템플릿 리터럴(backtick) → 일반 문자열 연결('...' + var + '...') 으로 교체. function(x){return} 형태 사용",
      "repeat_risk": "high — FL 서버 파일에 JS 코드 인라인 시 항상 발생. 모든 `` ` `` backtick 템플릿 리터럴 금지",
      "affected": [
        "akl-notify/app/server.fl"
      ],
      "date": "2026-05-20"
    },
    "err-009": {
      "t": "error",
      "v": "sed -i 상대경로 사용 시 파일 0바이트로 초기화",
      "cause": "sed -i 명령을 잘못된 CWD에서 상대경로로 실행 → 빈 파일 생성",
      "fix": "항상 절대경로 사용: sed -i '...' /absolute/path/to/file.fl",
      "repeat_risk": "high",
      "date": "2026-05-20"
    },
