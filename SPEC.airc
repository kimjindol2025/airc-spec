{
  "$": "airc-spec",
  "version": "0.1.0",
  "date": "2026-05-20",
  "cmd": "python3 -c \"import json; d=json.load(open('SPEC.airc')); print('hot:', d['hot']); print('next:', d['nodes'][d['hot']]['next'])\"",
  "hot": "task-005",
  "constitution": {
    "1_audience": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2_consistency": "기록 형식과 읽기 형식이 동일한 규칙. 예외 없음",
    "3_purpose_lock": "초기 설계 목적은 잠긴다. 변경은 사용자 협의 후에만. Claude 단독 변경 금지",
    "4_error_log": "실수, 오류, 반복 패턴도 nodes에 기록. 성공만 기록하지 않는다",
    "5_verified_only": "검증된 사실만 fact 타입. 추측은 assumption으로 분리",
    "6_handoff": "hot + next + lock + graveyard + session.handoff 가 다음 Claude 인수인계 전부",
    "7_append_only": "노드는 삭제하지 않는다. lifecycle.state=void 로만 무효화",
    "8_lock_requires_why": "why 없는 lock 등록 불가. 이유 모르는 금지는 다음 Claude가 무시한다",
    "9_session_minimal": "세션 기록은 current + handoff 만. 전체 로그는 외부 파일로 분리",
    "10_assumption_lifecycle": "assumption은 검증 후 resolved_by 로 fact 연결 필수",
    "11_user_intent_immutable": "사용자 발언은 quote 필드에 원문 보존. 요약/해석 금지. immutable:true"
  },
  "node_types": {
    "problem": "현재 문제 — 해결 전까지 hot 가능",
    "task": "다음 행동 — entry + check + verified 필수",
    "decision": "구조 결정 — why 필수. lock:true 가능",
    "fact": "검증된 사실 — verified:true 필수",
    "assumption": "검증 전 가정 — verify_by 필수. status:pending",
    "error": "실패 기록 — cause + fix + repeat_risk 필수",
    "user_intent": "사용자 원문 — quote 필드. immutable:true 필수"
  },
  "field_rules": {
    "all_nodes": [
      "t",
      "v"
    ],
    "task": [
      "entry",
      "check",
      "verified",
      "next"
    ],
    "decision": [
      "why",
      "verified"
    ],
    "fact": [
      "verified:true"
    ],
    "assumption": [
      "verify_by",
      "status"
    ],
    "error": [
      "cause",
      "fix",
      "repeat_risk"
    ],
    "user_intent": [
      "quote",
      "source",
      "immutable:true"
    ],
    "lock_item": [
      "rule",
      "why",
      "source",
      "severity"
    ],
    "lifecycle": [
      "state",
      "by",
      "at"
    ]
  },
