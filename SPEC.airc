    "dec-step4-why-command-design": {
      "t": "decision",
      "v": "AIRC `why` 명령: AI 네이티브 설계 (구조화, 인간 요약 제거)",
      "why": [
        "grep 검색은 관계를 못 본다",
        "인간 가독성 제거 = AI 추론 용이성 증대",
        "한 번의 쿼리로 전체 맥락 반환 (추가 조회 불필요)",
        "depth/type/circular_ref 명시적 표시 → AI가 자동 정렬 가능"
      ],
      "design": {
        "query_format": "airc why <node-id>",
        "output_structure": [
          "node metadata (type, value)",
          "dependencies (needs, blocks)",
          "blocking_chain (direct + transitive by depth)",
          "decision_context (relevant decisions)",
          "errors_relevant (related errors + fixes)",
          "assumptions (verification status)",
          "provenance (who/when/why created)",
          "related_projects (clustering)",
          "why_blocked (current blocking factors)"
        ],
        "ai_capabilities": [
          "의존성 추론 (직접/간접)",
          "reverse blocking (역쿼리: 누가 이것을 기다리는가)",
          "decision alignment check (정책 위반 여부)",
          "error clustering (같은 에러로 막힌 그룹)",
          "priority ranking (blocking_chain depth로 자동 정렬)"
        ]
      },
      "implementation": {
        "phase1": "airc-why-loader.fl (데이터 로드)",
        "phase2": "airc-graph-traverse.fl (transitive closure)",
        "phase3": "airc-why-json.fl (AI 최적화 JSON 생성)",
        "phase4": "airc.fl에 why 명령 통합",
        "phase5": "5개 샘플로 검증"
      },
      "verified": false,
      "lock": false,
      "lifecycle": {
        "state": "active"
      }
    },
