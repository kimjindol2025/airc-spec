{
  "$": "airc-spec",
  "version": "0.1.0",
  "date": "2026-05-20",
  "cmd": "python3 -c \"import json; d=json.load(open('SPEC.airc')); print('hot:', d['hot']); print('next:', d['nodes'][d['hot']]['next'])\"",

  "hot": "task-001",

  "constitution": {
    "1_audience": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2_consistency": "기록 형식과 읽기 형식이 동일한 규칙. 예외 없음",
    "3_purpose_lock": "초기 설계 목적은 잠긴다. 변경은 사용자 협의 후에만. Claude 단독 변경 금지",
    "4_error_log": "실수, 오류, 반복 패턴도 nodes에 기록. 성공만 기록하지 않는다",
    "5_verified_only": "검증된 사실만 fact 타입. 추측은 assumption으로 분리",
    "6_handoff": "hot + next + lock + graveyard + session.handoff 가 다음 Claude 인수인계 전부",
    "7_append_only": "노드는 삭제하지 않는다. lifecycle.state=void 로만 무효화",
    "8_lock_requires_why": "why 없는 lock 등록 불가. 이유 모르는 금지는 다음 Claude가 무시한다",
    "9_session_minimal": "세션 기록은 current + handoff 만. 전체 로그는 외부 파일로 분리",
    "10_assumption_lifecycle": "assumption은 검증 후 resolved_by 로 fact 연결 필수",
    "11_user_intent_immutable": "사용자 발언은 quote 필드에 원문 보존. 요약/해석 금지. immutable:true"
  },

  "node_types": {
    "problem":     "현재 문제 — 해결 전까지 hot 가능",
    "task":        "다음 행동 — entry + check + verified 필수",
    "decision":    "구조 결정 — why 필수. lock:true 가능",
    "fact":        "검증된 사실 — verified:true 필수",
    "assumption":  "검증 전 가정 — verify_by 필수. status:pending",
    "error":       "실패 기록 — cause + fix + repeat_risk 필수",
    "user_intent": "사용자 원문 — quote 필드. immutable:true 필수"
  },

  "field_rules": {
    "all_nodes":      ["t", "v"],
    "task":           ["entry", "check", "verified", "next"],
    "decision":       ["why", "verified"],
    "fact":           ["verified:true"],
    "assumption":     ["verify_by", "status"],
    "error":          ["cause", "fix", "repeat_risk"],
    "user_intent":    ["quote", "source", "immutable:true"],
    "lock_item":      ["rule", "why", "source", "severity"],
    "lifecycle":      ["state", "by", "at"]
  },

  "lifecycle_states": ["active", "void", "deprecated", "superseded", "experimental", "frozen"],

  "nodes": {

    "task-001": {
      "t": "task",
      "v": "SPEC.airc 확정 및 airc-parser.fl 구현",
      "entry": [
        "/home/kimjin/kim/Desktop/kim/02_Infrastructure/airc-spec/SPEC.airc",
        "airc-parser.fl (미생성)"
      ],
      "check": ["node /home/kimjin/freelang-v11/bootstrap.js run airc-parser.fl"],
      "verified": false,
      "next": ["task-002"]
    },

    "task-002": {
      "t": "task",
      "v": "CLI 구현: airc read / airc why / airc graveyard / airc next",
      "verified": false,
      "next": ["task-003"]
    },

    "task-003": {
      "t": "task",
      "v": "FREEDOC.fds → .airc 마이그레이션 도구",
      "verified": false,
      "next": []
    },

    "dec-001": {
      "t": "decision",
      "v": "포맷은 JSON. transport layer. 본질은 AI State Graph",
      "why": ["파싱 100% 확실", "타입 명확", "추론 불필요", "validator 구현 가능"],
      "verified": true,
      "lock": true,
      "lifecycle": { "state": "active" }
    },

    "dec-002": {
      "t": "decision",
      "v": "append-only. 노드 삭제 금지. lifecycle.state=void 로만 무효화",
      "why": [
        "삭제하면 왜 폐기됐는지 증발",
        "회귀 방지 실패",
        "과거 결정 인과 붕괴"
      ],
      "verified": true,
      "lock": true,
      "lifecycle": { "state": "active" }
    },

    "dec-003": {
      "t": "decision",
      "v": "replaces 필드로 canonical 노드 명시",
      "why": ["AI는 무엇이 현재 유효한지 즉시 알아야 함"],
      "verified": true,
      "lifecycle": { "state": "active" }
    },

    "u-001": {
      "t": "user_intent",
      "quote": "초기 기획이 바보 같더라도 진행하면서 문제를 찾아야지 이거 바보네 하고 바로 수정해버리는 습관 제거",
      "source": { "date": "2026-05-20", "speaker": "user" },
      "immutable": true
    },

    "u-002": {
      "t": "user_intent",
      "quote": "문서 목적은 이걸 읽는순간 뭘 해야되는지 알아야됨",
      "source": { "date": "2026-05-20", "speaker": "user" },
      "immutable": true
    },

    "u-003": {
      "t": "user_intent",
      "quote": "목적이 같아야됨. 초기 설정이 유지 문제 발생시 사용자랑 협의 혼자 변경금지",
      "source": { "date": "2026-05-20", "speaker": "user" },
      "immutable": true
    },

    "a-001": {
      "t": "assumption",
      "v": "FreeLang v11로 JSON 파서 구현 가능",
      "verify_by": ["node bootstrap.js run airc-parser.fl"],
      "status": "pending",
      "resolved_by": null
    },

    "err-001": {
      "t": "error",
      "v": "FREEDOC v2 validator가 PHASES/COMMANDS/NEXT 블록 거부",
      "when": "2026-05-20",
      "cause": "허용 블록명 제한",
      "fix": "FIXED 블록으로 통합",
      "repeat_risk": "high",
      "note": "freedoc validate 전 블록명 사전 확인 필수"
    }
  },

  "lock": [
    {
      "rule": "인간 가독성을 위한 구조 타협 금지",
      "why": "AI용 포맷의 본질 훼손",
      "source": "u-001",
      "severity": 10
    },
    {
      "rule": "추측을 verified:true로 기록 금지",
      "why": "assumption contamination — 사실과 추측이 섞이면 전체 신뢰도 붕괴",
      "source": "constitution.5_verified_only",
      "severity": 10
    },
    {
      "rule": "graveyard 항목 재오픈 금지",
      "why": "이유 없는 재도입은 반복 실패 보장",
      "source": "dec-002",
      "severity": 9
    },
    {
      "rule": "사용자 협의 없이 constitution 변경 금지",
      "why": "u-003 직접 인용. Claude 단독 판단으로 목적 이탈 방지",
      "source": "u-003",
      "severity": 10
    },
    {
      "rule": "user_intent 노드 요약/해석 금지. quote는 원문만",
      "why": "interpretation drift 방지. 요약이 쌓이면 원의도 왜곡",
      "source": "constitution.11_user_intent_immutable",
      "severity": 10
    }
  ],

  "graveyard": [
    {
      "idea": "FREEDOC v2 블록 구조",
      "why": "document 사고방식. AI 탐색 불가. err-001이 증거",
      "verified": true,
      "final": true
    },
    {
      "idea": "마크다운 기반 AI 메모리",
      "why": "자유 형식 = 구조 추론에 토큰 낭비. 일관성 강제 불가",
      "verified": true,
      "final": true
    },
    {
      "idea": "현재 상태만 저장 (이유 없음)",
      "why": "인과관계 없으면 다음 Claude가 같은 실수 반복",
      "verified": true,
      "final": true
    },
    {
      "idea": "전체 세션 로그를 .airc 내부에 저장",
      "why": "빠르게 거대화. token pollution. stale noise",
      "verified": false,
      "final": true
    }
  ],

  "session": {
    "current": {
      "model": "claude-sonnet-4.6",
      "date": "2026-05-20",
      "focus": "SPEC.airc 확정"
    },
    "handoff": [
      "SPEC.airc 스펙 확정 완료",
      "task-001: airc-parser.fl 미구현",
      "a-001: FreeLang JSON 파싱 가능 여부 미검증",
      "graveyard 확인 후 작업 시작"
    ]
  }
}
