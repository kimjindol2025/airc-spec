    "err-015": {
      "t": "error",
      "v": "KimDB API key 미설정 — akl-api/akl-hr/akl-notify 전부 401 silent fail",
      "cause": "KimDB(40003)는 X-API-Key: fl-json-db-v2-key 필요. 모든 서비스가 http_get/http_post로 API key 없이 호출 → 401 → try/catch 없이 silently fail",
      "fix": "http_get_key / http_post_key 함수로 교체 + {:data item} 포맷 준수",
      "affected": [
        "akl-notify/app/server.fl",
        "akl-hr/app/server.fl",
        "akl-api/src/main.fl"
      ],
      "repeat_risk": "high — 새 KimDB 클라이언트 코드 작성 시 반드시 http_get_key/http_post_key 사용",
      "root_cause": "KimDB.env에만 KIMDB_API_KEY 있고 클라이언트에 전파 안 됨",
      "date": "2026-05-20"
    },
    "err-016": {
      "t": "error",
      "v": "KimDB POST body 포맷 오류 — {data: item} 아닌 item 직접 전송",
      "cause": "KimDB API는 POST body로 {data: {...}} 형식 요구. item을 직접 json_stringify하면 'data is required' 오류",
      "fix": "(json-stringify {:data $item}) 형태로 래핑",
      "repeat_risk": "high",
      "date": "2026-05-20"
    },
    "err-017": {
      "t": "error",
      "v": "KimDB 응답 필드명 오류 — docs → data",
      "cause": "KimDB GET 응답은 'data' 필드에 배열 반환. 기존 코드가 'docs'로 읽어서 항상 nil 반환",
      "fix": "(get $body 'data') 로 변경",
      "repeat_risk": "medium",
      "date": "2026-05-20"
    },
