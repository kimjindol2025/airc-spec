;; build-index.fl — SPEC.airc 인덱스 자동 재생성
;; 사용법: node bootstrap.js run build-index.fl
;; 노드에 tags/provenance/deps/lifecycle 추가 후 이 스크립트 실행하면 index 자동 빌드

(define SPEC_PATH "/home/kimjin/kim/Desktop/kim/02_Infrastructure/airc-spec/SPEC.airc")

(let [$raw (file-read SPEC_PATH)]
  (if (nil-or-empty? $raw)
    (println (str "ERROR: 없음 — " SPEC_PATH))
    (let [$spec  (json-parse $raw)
          $nodes (get $spec "nodes")
          $nids  (keys $nodes)

          $by-type   (atom {})
          $by-tag    (atom {})
          $active    (atom [])
          $dead      (atom [])
          $prov-g    (atom {})
          $dep-g     (atom {})]

      (doseq [$nid $nids]
        (let [$node  (get $nodes $nid)
              $t     (get $node "t")
              $tags  (get $node "tags")
              $state (get-in $node ["lifecycle" "state"])
              $lc    (if (nil? $state) "active" $state)
              $prov  (get $node "provenance")
              $deps  (get $node "deps")]

          ;; by_type
          (let [$cur (get (deref $by-type) $t)]
            (swap! $by-type (fn [$m] (assoc $m $t (conj (if (nil? $cur) [] $cur) $nid)))))

          ;; by_tag
          (when (not (nil? $tags))
            (doseq [$tag $tags]
              (let [$cur (get (deref $by-tag) $tag)]
                (swap! $by-tag (fn [$m] (assoc $m $tag (conj (if (nil? $cur) [] $cur) $nid)))))))

          ;; active / dead
          (if (or (= $lc "active") (= $lc "confirmed"))
            (swap! $active (fn [$a] (conj $a $nid)))
            (swap! $dead   (fn [$a] (conj $a $nid))))

          ;; provenance graph
          (swap! $prov-g (fn [$m]
            (assoc $m $nid {
              "from"   (if (nil? $prov) [] (get $prov "from"))
              "causes" (if (nil? $prov) [] (get $prov "causes"))
            })))

          ;; dep graph
          (swap! $dep-g (fn [$m]
            (assoc $m $nid {
              "needs"  (if (nil? $deps) [] (get $deps "needs"))
              "blocks" (if (nil? $deps) [] (get $deps "blocks"))
            })))))

      (let [$index {
              "by_type"          (deref $by-type)
              "by_tag"           (deref $by-tag)
              "active"           (deref $active)
              "dead"             (deref $dead)
              "provenance_graph" (deref $prov-g)
              "dep_graph"        (deref $dep-g)
              "_generated"       "2026-05-20"
              "_note"            "auto-generated by build-index.fl — do not edit manually"
            }
            $updated (assoc $spec "index" $index)]

        (file-write SPEC_PATH (json-stringify $updated))
        (println "인덱스 재생성 완료")
        (println (str "  nodes:  " (str (length $nids))))
        (println (str "  active: " (str (length (deref $active)))))
        (println (str "  dead:   " (str (length (deref $dead)))))
        (println (str "  tags:   " (str (length (keys (deref $by-tag))))))))))
