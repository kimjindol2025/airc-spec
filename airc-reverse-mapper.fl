;; airc-reverse-mapper.fl — Reverse map (blocked_by, depends_on, error_references)
;; 입력: airc-graph.json
;; 출력: data/reverse-map.json

(define GRAPH-PATH "/home/kimjin/kim/Desktop/kim/02_Infrastructure/airc-spec/data/airc-graph.json")
(define REVERSE-PATH "/home/kimjin/kim/Desktop/kim/02_Infrastructure/airc-spec/data/reverse-map.json")

;; --- 역인덱스 빌더 ---

(defn build-blocked-by-map [$graph]
  "blocked_by 역인덱스: blocker → [affected projects]"
  (let [$nodes (get $graph "nodes" {})
        $map (atom {})]

    (doseq [$node-id (keys $nodes)]
      (let [$node (get $nodes $node-id)
            $blocked-by (get $node "blocked_by")]
        (when (and (not (nil? $blocked-by)) (not (empty? $blocked-by)))
          (swap! $map
            (fn [$m]
              (let [$existing (get $m $blocked-by [])
                    $new-entry {
                      "node-id" $node-id
                      "node-type" (get $node "t")
                      "status" (get $node "status" "unknown")
                    }]
                (assoc $m $blocked-by (concat $existing [$new-entry]))))))))

    (deref $map)))

(defn build-depends-on-map [$graph]
  "depends_on 역인덱스: dependency → [dependent projects]"
  (let [$nodes (get $graph "nodes" {})
        $map (atom {})]

    (doseq [$node-id (keys $nodes)]
      (let [$node (get $nodes $node-id)
            $next (get $node "next" [])]
        (doseq [$dep $next]
          (when (not (empty? $dep))
            (swap! $map
              (fn [$m]
                (let [$existing (get $m $dep [])
                      $new-entry {
                        "node-id" $node-id
                        "node-type" (get $node "t")
                      }]
                  (assoc $m $dep (concat $existing [$new-entry])))))))))

    (deref $map)))

(defn build-error-references [$graph]
  "에러 참조: error → [affected nodes]"
  (let [$nodes (get $graph "nodes" {})
        $errors (atom {})
        $error-index (atom {})]

    ;; Step 1: 모든 에러 노드 수집
    (doseq [$node-id (keys $nodes)]
      (let [$node (get $nodes $node-id)]
        (when (= (get $node "t") "error")
          (swap! $errors
            (fn [$e]
              (assoc $e $node-id $node))))))

    ;; Step 2: 각 노드에서 에러 참조 추적
    (doseq [$node-id (keys $nodes)]
      (let [$node (get $nodes $node-id)
            $cause (get $node "cause" "")
            $fix (get $node "fix" "")]

        ;; 간단한 패턴 매칭: "err-" 으로 시작하는 에러 ID 찾기
        (doseq [$error-id (keys (deref $errors))]
          (when (or (str-includes $cause $error-id)
                    (str-includes $fix $error-id))
            (swap! $error-index
              (fn [$ei]
                (let [$existing (get $ei $error-id [])
                      $new-entry {
                        "node-id" $node-id
                        "node-type" (get $node "t")
                      }]
                  (assoc $ei $error-id (concat $existing [$new-entry])))))))))

    {
      "errors" (deref $errors)
      "error-references" (deref $error-index)
    }))

(defn build-project-impact [$blocked-by-map $depends-on-map $error-refs]
  "프로젝트별 영향도 분석"
  (let [$impact (atom {})]

    ;; blocked_by 영향도
    (doseq [$blocker (keys $blocked-by-map)]
      (let [$affected (get $blocked-by-map $blocker)]
        (swap! $impact
          (fn [$i]
            (let [$existing (get $i $blocker {})]
              (assoc $i $blocker
                (assoc $existing
                  "blocked_by_count" (length $affected)
                  "affected_nodes" $affected)))))))

    ;; depends_on 영향도
    (doseq [$dep (keys $depends-on-map)]
      (let [$dependents (get $depends-on-map $dep)]
        (swap! $impact
          (fn [$i]
            (let [$existing (get $i $dep {})]
              (assoc $i $dep
                (assoc $existing
                  "depends_on_count" (length $dependents)
                  "dependent_nodes" $dependents)))))))

    (deref $impact)))

;; --- 메인 ---

(println "🔄 AIRC Reverse Mapper 시작...")
(println "")

;; 그래프 로드
(println "📖 airc-graph.json 로드...")
(let [$graph-content (file-read GRAPH-PATH)]
  (if (nil? $graph-content)
    (do
      (println "❌ airc-graph.json 로드 실패")
      (process-exit 1))
    (let [$graph (json-parse $graph-content)]
      (println "✅ 로드 완료")

      ;; blocked_by 역인덱스
      (println "")
      (println "🔗 Step 1: blocked_by 역인덱스 생성...")
      (let [$blocked-by-map (build-blocked-by-map $graph)
            $blocker-count (count (keys $blocked-by-map))
            $total-blocked (reduce (fn [$acc $blocker]
                                    (+ $acc (length (get $blocked-by-map $blocker))))
                                  0
                                  (keys $blocked-by-map))]
        (println (str "✅ 완료 — " $blocker-count " 블로커, " $total-blocked " 영향받는 노드"))

        ;; depends_on 역인덱스
        (println "🔗 Step 2: depends_on 역인덱스 생성...")
        (let [$depends-on-map (build-depends-on-map $graph)
              $dep-count (count (keys $depends-on-map))
              $total-deps (reduce (fn [$acc $dep]
                                   (+ $acc (length (get $depends-on-map $dep))))
                                 0
                                 (keys $depends-on-map))]
          (println (str "✅ 완료 — " $dep-count " 의존성, " $total-deps " 의존 노드"))

          ;; error 참조
          (println "🔗 Step 3: 에러 참조 매핑...")
          (let [$error-result (build-error-references $graph)
                $error-count (length (get $error-result "errors" []))
                $ref-count (count (keys (get $error-result "error-references" {})))]
            (println (str "✅ 완료 — " $error-count " 에러, " $ref-count " 참조"))

            ;; 프로젝트 영향도
            (println "📊 Step 4: 프로젝트 영향도 분석...")
            (let [$impact (build-project-impact $blocked-by-map $depends-on-map $error-result)]
              (println (str "✅ 완료 — " (count (keys $impact)) " 항목"))

              ;; 저장
              (println "")
              (println "💾 역맵 저장...")
              (let [$output {
                    "$" "airc-reverse-map"
                    "version" "0.1.0"
                    "generated" (now-iso)
                    "stats" {
                      "blockers" $blocker-count
                      "blocked_total" $total-blocked
                      "dependencies" $dep-count
                      "dependents_total" $total-deps
                      "errors" $error-count
                      "error_references" $ref-count
                    }
                    "blocked_by_index" $blocked-by-map
                    "depends_on_index" $depends-on-map
                    "error_references" (get $error-result "error-references" {})
                    "impact" $impact
                  }
                    $json (json-stringify $output)]
                (file-write REVERSE-PATH $json)
                (println (str "✅ 저장 완료: " REVERSE-PATH))

                ;; 요약
                (println "")
                (println "════════════════════════════════════════")
                (println "✅ AIRC Reverse Mapper 완료")
                (println "════════════════════════════════════════")
                (println "📊 역인덱스 통계:")
                (println (str "   Blockers: " $blocker-count " (영향: " $total-blocked " 노드)"))
                (println (str "   Dependencies: " $dep-count " (영향: " $total-deps " 노드)"))
                (println (str "   Errors: " $error-count " (참조: " $ref-count ")"))
                (println (str "   Impact Items: " (count (keys $impact))))
                (println "")

                ;; TOP 3 blockers
                (println "🔥 가장 많은 영향: ")
                (let [$sorted (sort-by (fn [$entry]
                                        (let [$blocker (first $entry)
                                              $data (second $entry)]
                                          (- (get $data "blocked_by_count" 0))))
                                      (map (fn [$k] [$k (get $impact $k)]) (keys $impact)))]
                  (doseq [$entry (take 3 $sorted)]
                    (let [$blocker (first $entry)
                          $data (second $entry)]
                      (println (str "   - " $blocker ": " (get $data "blocked_by_count" 0) " 노드")))))

                (println "")
                (println (str "📍 출력: " REVERSE-PATH))))))))))
