{
  "$": "airc-spec",
  "version": "0.1.0",
  "date": "2026-05-20",
  "cmd": "cat DESIGN.airc | python3 -c \"import sys,json; d=json.load(sys.stdin); print('HOT:', d['hot']); print('NEXT:', [d['nodes'][d['hot']]['next']]); print('LOCK:', d['lock'][:2])\"",

  "hot": "task-001",

  "constitution": {
    "1_audience": "AI 전용. 인간 가독성을 위한 구조 타협 금지",
    "2_consistency": "기록 형식과 읽기 형식이 동일한 규칙을 따른다. 예외 없음",
    "3_purpose_lock": "초기 설계 목적은 잠긴다. 변경은 사용자 협의 후에만 가능. Claude 단독 변경 금지",
    "4_error_log": "구현 중 실수, 오류, 반복 패턴도 nodes에 기록한다. 성공만 기록하지 않는다",
    "5_verified_only": "검증된 사실만 nodes에 등록한다. 추측은 t=hypothesis로 분리",
    "6_handoff": "hot + next + lock + graveyard가 다음 Claude 인수인계 전부다. 누락 금지"
  },

  "nodes": {

    "task-001": {
      "t": "task",
      "v": "airc-parser.fl 구현 (FreeLang v11)",
      "entry": ["airc-parser.fl"],
      "check": ["node /home/kimjin/freelang-v11/bootstrap.js run airc-parser.fl"],
      "verified": false,
      "next": ["task-002"]
    },

    "task-002": {
      "t": "task",
      "v": "CLI 4개 구현: airc read / airc why / airc graveyard / airc next",
      "verified": false,
      "next": ["task-003"]
    },

    "task-003": {
      "t": "task",
      "v": "프로젝트 FREEDOC.fds → .airc 마이그레이션 도구",
      "verified": false,
      "next": []
    },

    "dec-001": {
      "t": "decision",
      "v": "포맷은 JSON. transport일 뿐 본질은 AI State Graph",
      "why": ["JSON 파싱 100% 확실", "타입 명확", "추론 불필요"],
      "verified": true,
      "lock": true
    },

    "dec-002": {
      "t": "decision",
      "v": "graveyard 필수. 버린 이유 없는 항목은 등록 불가",
      "why": ["Claude는 세션마다 버린 아이디어를 재도입한다", "이유 없는 기록은 무의미"],
      "verified": true,
      "lock": true
    },

    "dec-003": {
      "t": "decision",
      "v": "초기 기획 바보 같아도 실행 먼저. 수정은 문제 발견 후",
      "why": ["실행 전 수정은 방향을 잃게 만든다", "문제는 실행하면서 발견된다"],
      "verified": true,
      "lock": true
    },

    "dec-004": {
      "t": "decision",
      "v": "목적 변경은 사용자 협의 필수. Claude 단독 변경 금지",
      "why": ["Claude의 판단이 설계자 의도를 덮으면 방향이 이탈한다"],
      "verified": true,
      "lock": true
    },

    "err-001": {
      "t": "error",
      "v": "FREEDOC v2 블록 파서가 PHASES/COMMANDS/NEXT 블록을 거부",
      "when": "2026-05-20",
      "cause": "freedoc validator가 허용 블록명을 제한함",
      "fix": "FIXED 블록으로 통합",
      "repeat_risk": "high",
      "note": "freedoc validate 전에 블록명 사전 확인 필수"
    }
  },

  "lock": [
    "인간 가독성을 위한 구조 타협 금지",
    "추측을 verified:true로 기록 금지",
    "graveyard 항목 재오픈 금지",
    "사용자 협의 없이 constitution 변경 금지",
    "hot/next/lock/graveyard 누락한 .airc 파일 생성 금지"
  ],

  "graveyard": [
    {
      "idea": "FREEDOC v2 블록 구조 (IDENTITY/POSITION/MAP/FIXED)",
      "why": "document 사고방식. AI 탐색 불가. 검증: freedoc validate 실패 반복",
      "verified": true,
      "final": true
    },
    {
      "idea": "마크다운 기반 AI 메모리",
      "why": "자유 형식 = 구조 추론에 토큰 낭비. 일관성 규칙 강제 불가",
      "verified": true,
      "final": true
    },
    {
      "idea": "현재 상태만 저장",
      "why": "인과관계 없으면 다음 Claude가 같은 실수 반복. err-001이 증거",
      "verified": true,
      "final": true
    }
  ],

  "handoff": {
    "to_next_claude": "이 파일을 읽는 순간 다음을 순서대로 실행하라",
    "step1": "cmd 실행해서 현재 hot/next/lock 확인",
    "step2": "graveyard 확인 후 이미 버린 방향인지 체크",
    "step3": "hot 노드의 next 태스크 실행",
    "step4": "구현 중 오류 발생 시 err-* 노드로 기록",
    "step5": "목적 변경 필요 시 단독 변경 금지 — 사용자에게 먼저 물어라",
    "warning": "constitution은 변경하지 않는다. 읽고 따른다"
  }
}
